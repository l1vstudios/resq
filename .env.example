REDNODE_HEARTBEAT_MS=1000
REDNODE_LOGGER_CODE=REDNODE-BLIIOT-01
REDNODE_SERIAL_PORT=/dev/ttyAS2
REDNODE_BAUD_RATE=9600
REDNODE_DATA_BITS=8
REDNODE_STOP_BITS=1
REDNODE_PARITY=none
REDNODE_TIMEOUT_MS=1500
REDNODE_CONFIG_REFRESH_MS=5000
REDNODE_POLL_INTERVAL_MS=1000
REDNODE_SSH_HOST=
REDNODE_SSH_PORT=22
REDNODE_SSH_USER=root
REDNODE_SSH_PASSWORD=
REDNODE_GATEWAY_PATH=/root/rednode-gateway
REDNODE_MQTT_ENABLED=false
REDNODE_MQTT_BROKER_URL=
REDNODE_MQTT_TOPIC_PREFIX=resq/telemetry
