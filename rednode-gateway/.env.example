# RedNode Gateway Environment
# Aktifkan salah satu mode saja: development LAN atau production VPS.
# Cara pakai: copy file ini menjadi .env, lalu comment blok yang tidak dipakai.

# =========================
# DEVELOPMENT - LAN LOKAL
# =========================
# Pakai ini saat web Laravel jalan di laptop/server lokal satu jaringan dengan RedNode.
APP_URL=http://192.168.3.10:8000
REDNODE_CONFIG_URL=http://192.168.3.10:8000/api/rednode/config
REDNODE_CALLBACK_URL=http://192.168.3.10:8000/api/realtime-sensor-status
REDNODE_HEARTBEAT_URL=http://192.168.3.10:8000/api/rednode/heartbeat

# =========================
# PRODUCTION - VPS
# =========================
# Pakai ini saat RedNode punya internet/4G dan langsung akses server VPS.
# APP_URL=http://139.59.100.220
# REDNODE_CONFIG_URL=http://139.59.100.220/api/rednode/config
# REDNODE_CALLBACK_URL=http://139.59.100.220/api/realtime-sensor-status
# REDNODE_HEARTBEAT_URL=http://139.59.100.220/api/rednode/heartbeat

# =========================
# COMMON CONFIG
# =========================
# Opsional. Kosongkan agar Laravel memilih Data Logger dari database berdasarkan IP RedNode.
# REDNODE_LOGGER_CODE=DL-PDG-001

# Opsional tapi sangat disarankan untuk multi logger via internet.
# Device akan tetap bisa terdeteksi otomatis walau logger code belum diisi.
# REDNODE_DEVICE_UID=RN-BL118-0001
# REDNODE_SERIAL_NUMBER=BL118-0001
# REDNODE_DEVICE_MODEL=BL118 Bliiot
# REDNODE_DEVICE_VENDOR=Bliiot
# REDNODE_FIRMWARE_VERSION=BL118-1.0.0
# REDNODE_DEVICE_LABEL=Gateway Lapangan 001

REDNODE_SERIAL_PORT=/dev/ttyAS2
REDNODE_BAUD_RATE=9600
REDNODE_DATA_BITS=8
REDNODE_STOP_BITS=1
REDNODE_PARITY=none
REDNODE_TIMEOUT_MS=1500
REDNODE_CONFIG_REFRESH_MS=5000
REDNODE_HEARTBEAT_MS=1000
